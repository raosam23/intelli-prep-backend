# Copy this file to .env and replace the placeholder secrets.
# pydantic-settings reads these names. Do not commit a real .env file.

APP_NAME=IntelliPrep
APP_ENV=development
DEBUG=true

# Async SQLAlchemy URL. The API and Alembic both use this variable.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/intelliprep

# JWT signing
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# bcrypt cost. When unset, the application defaults to 12.
SALT_ROUNDS=12

# Used by the LangGraph interview agent (ChatOpenAI, gpt-4o-mini).
OPENAI_API_KEY=sk-your-key
